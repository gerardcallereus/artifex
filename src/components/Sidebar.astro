---
import type { Props } from '@astrojs/starlight/props';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SiteTitle from 'virtual:starlight/components/SiteTitle';

const { sidebar } = Astro.props;
---

<div class="sidebar-header sl-hidden md:sl-flex">
  <div class="sidebar-top-bar">
    <button id="sidebar-toggle-btn" class="sidebar-toggle-btn" type="button" aria-label="Comprimir o expandir menú">
      <svg class="hamburger-icon" viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div class="sidebar-title-wrapper">
      <SiteTitle {...Astro.props} />
    </div>
  </div>
</div>

<SidebarSublist sublist={sidebar} />

<div class="md:sl-hidden">
  <MobileMenuFooter {...Astro.props} />
</div>

<script>
  function setupSidebarToggle() {
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const root = document.documentElement;

    if (!toggleBtn) return;

    toggleBtn.addEventListener('click', () => {
      const isCollapsed = root.classList.toggle('sidebar-collapsed');
      localStorage.setItem('artifex-sidebar', isCollapsed ? 'collapsed' : 'expanded');
    });

    // Restore user preference
    if (localStorage.getItem('artifex-sidebar') === 'collapsed') {
      root.classList.add('sidebar-collapsed');
    }
  }

  setupSidebarToggle();
  document.addEventListener('astro:page-load', setupSidebarToggle);
</script>

<style>
  .sidebar-header {
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    margin-bottom: 1rem;
  }

  .sidebar-top-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .sidebar-toggle-btn {
    padding: 0.45rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .sidebar-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .sidebar-title-wrapper {
    flex-grow: 1;
    overflow: hidden;
  }

  /* Force search button formatting in sidebar */
  :global(.sidebar-header starlight-search) {
    width: 100%;
  }

  :global(.sidebar-header starlight-search button) {
    width: 100% !important;
    justify-content: flex-start !important;
    padding-inline: 0.75rem !important;
    background: rgba(255, 255, 255, 0.1) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    color: #ffffff !important;
    border-radius: 8px !important;
  }

  :global(.sidebar-header starlight-search button:hover) {
    background: rgba(255, 255, 255, 0.2) !important;
  }
</style>
